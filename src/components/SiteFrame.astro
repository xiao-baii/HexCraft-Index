---
import { config } from "@/lib/config"
import styles from "./SiteFrame.module.css"

const isHome = Astro.url.pathname === "/"
---

<div class={styles.page} id="top">
  <a class={styles.skipLink} href="#main">跳到主要内容</a>

  <header class:list={[styles.header, { [styles.headerDivided]: !isHome }]}>
    <div class={styles.headerContent}>
      <a class={styles.brand} href="/" aria-label="xiao-baii 首页">
        <img
          class={styles.sailboat}
          src="/sailboat.svg"
          width="40"
          height="40"
          alt=""
        />
        <img
          class={styles.wordmark}
          src="/xiao-baii.svg"
          width="135"
          height="21"
          alt=""
        />
      </a>

      <nav class={styles.navigation} aria-label="主页导航">
        <a href="/" aria-current={isHome ? "page" : undefined}>首页</a>
      </nav>

      <a
        class={styles.github}
        href={config.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub（新窗口打开）"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 19 4.77 5.07 5.07 0 0 0 18.91 1S17.73.65 15 2.48a13.38 13.38 0 0 0-7 0C5.27.65 4.09 1 4.09 1A5.07 5.07 0 0 0 4 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 8 18.13V22"
          ></path>
        </svg>
      </a>
    </div>
  </header>

  <slot />

  <footer class={styles.footer}>
    <div class={styles.footerContent}>
      <span class={styles.copyright}
        >© {new Date().getFullYear()} xiao-baii</span
      >
      <a
        class={styles.beian}
        href={config.beian.link}
        target="_blank"
        rel="noopener noreferrer">{config.beian.number}</a
      >
    </div>
  </footer>
</div>
